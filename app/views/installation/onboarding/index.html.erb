<!DOCTYPE html>
<html>
  <head>
    <title>Setup | DigiLink</title>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'superadmin' %>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
      .dl-page {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        width: 100%;
        padding: 2.5rem 1.5rem;
        background-image: url('/brand-assets/digilink-login-bg.jpeg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
      }
      .dl-logo {
        position: absolute;
        top: 0.75rem;
        left: 1rem;
        height: 2.75rem;
        width: auto;
        object-fit: contain;
      }
      .dl-card {
        width: 100%;
        max-width: 31rem;
        padding: 2rem;
        border-radius: 1rem;
        background: rgba(0,0,0,0.05);
        border: 1px solid rgba(255,255,255,0.20);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
      }
      .dl-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: rgba(255,255,255,0.95);
        margin-bottom: 0.35rem;
      }
      .dl-field-wrap { margin-bottom: 1.1rem; }
      .dl-input {
        display: block;
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 1px solid rgba(255,255,255,0.45);
        color: #fff;
        font-size: 0.875rem;
        padding: 0.45rem 0.25rem 0.45rem 0;
        outline: none;
        appearance: none;
        border-radius: 0;
      }
      .dl-input::placeholder { color: rgba(255,255,255,0.50); }
      .dl-input:focus { border-bottom-color: rgba(255,255,255,0.90); }
      .dl-checkbox-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8125rem;
        color: rgba(255,255,255,0.85);
        margin-bottom: 0.5rem;
      }
      .dl-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 0.75rem 1rem;
        margin-top: 1.25rem;
        background: #9a6a6a;
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        border: none;
        border-radius: 0.6rem;
        cursor: pointer;
        box-shadow: 0 8px 24px rgba(0,0,0,0.2);
        transition: filter 0.15s;
      }
      .dl-btn:hover { filter: brightness(1.07); }
      .dl-error {
        border-radius: 0.5rem;
        background: rgba(239,68,68,0.15);
        border: 1px solid rgba(239,68,68,0.4);
        color: #fecaca;
        font-size: 0.875rem;
        padding: 0.75rem 1rem;
        margin-bottom: 1rem;
      }
    </style>
  </head>
  <body>
    <div class="dl-page">
      <img src="/brand-assets/digilink-topright-logo.png" alt="Digilink" class="dl-logo">
      <div class="dl-card">
        <%= form_tag('/installation/onboarding') do %>
          <% if flash[:error].present? %>
            <div class="dl-error"><%= flash[:error] %></div>
          <% end %>
          <div class="dl-field-wrap">
            <label class="dl-label">Name</label>
            <%= text_field :user, :name, placeholder: "Enter your full name. eg: Bruce Wayne",
                required: true, class: "dl-input" %>
          </div>
          <div class="dl-field-wrap">
            <label class="dl-label">Company Name</label>
            <%= text_field :user, :company, placeholder: "Enter your company name. eg: Wayne Enterprises",
                required: true, class: "dl-input" %>
          </div>
          <div class="dl-field-wrap">
            <label class="dl-label">Work Email</label>
            <%= email_field :user, :email, placeholder: "Enter your work email address.",
                required: true, class: "dl-input" %>
          </div>
          <div class="dl-field-wrap">
            <label class="dl-label">Password</label>
            <%= password_field :user, :password, placeholder: "Enter a password with 6 characters or more.",
                required: true, class: "dl-input" %>
          </div>
          <div class="dl-checkbox-row">
            <%= check_box_tag "subscribe_to_updates", 'true', true %>
            <label for="subscribe_to_updates">Subscribe to release notes & newsletters.</label>
          </div>
          <button type="submit" class="dl-btn">Finish Setup</button>
        <% end %>
      </div>
    </div>
  </body>
</html>
